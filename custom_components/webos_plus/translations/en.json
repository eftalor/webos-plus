{
  "config": {
    "step": {
      "user": {
        "title": "LG webOS TV Plus",
        "description": "Enter the TV's IP address. A fixed address (DHCP reservation) is recommended.",
        "data": {
          "host": "Host",
          "name": "Name"
        }
      },
      "pairing": {
        "title": "Pair with the TV",
        "description": "Make sure the TV at {host} is on. Press Submit, then accept the request on the TV with the remote within {timeout} seconds."
      },
      "reauth_confirm": {
        "title": "Pair again",
        "description": "The TV no longer accepts Home Assistant's key. Make sure the TV at {host} is on. Press Submit, then accept the request on the TV with the remote within {timeout} seconds."
      }
    },
    "error": {
      "cannot_connect": "Could not connect. Is the TV on and is \"LG Connect Apps\" enabled?",
      "error_pairing": "Pairing was rejected or not accepted in time."
    },
    "abort": {
      "already_configured": "This TV is already configured.",
      "reauth_successful": "Paired again."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Options",
        "data": {
          "broadcast_address": "Broadcast address",
          "macs": "MAC addresses (comma separated)",
          "root_agent": "Root agent (rooted TVs only)"
        },
        "data_description": {
          "macs": "Filled in automatically when pairing (wired and Wi-Fi).",
          "root_agent": "Adds memory, CPU and swap sensors, the real picture mode and a Free memory button. Needs SSH root access to the TV."
        }
      },
      "agent": {
        "title": "Install the root agent",
        "description": "On the TV at {host}, as root:\n\n1. Copy `tv/agent.sh` from the repository to `{agent_path}` and make it executable (`chmod 755`).\n2. Add this line to `/home/root/.ssh/authorized_keys`:\n\n```\n{key_line}\n```\n\nThe key can only run the agent (no shell). Then press Submit to test the connection; the TV's SSH host key is remembered on the first success."
      }
    },
    "error": {
      "agent_auth": "The TV refused the key. Is the line in authorized_keys?",
      "agent_failed": "Could not reach the agent. Is the TV on, SSH enabled and the agent installed?"
    }
  },
